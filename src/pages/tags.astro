---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const counts = new Map<string, number>();
for (const post of await getCollection('posts')) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) || 0) + 1);
const tags = [...counts].sort((a,b) => b[1]-a[1] || a[0].localeCompare(b[0], 'ko'));
---
<BaseLayout title="태그" description="BBakGoSu IT의 글을 태그별로 찾아보세요." path="/tags/"><section class="container listing listing-page"><p class="eyebrow">INDEX</p><h1>태그</h1><div class="tag-cloud">{tags.map(([tag,count]) => <a href={`/tag/${encodeURIComponent(tag)}/`}>{tag} <small>{count}</small></a>)}</div></section></BaseLayout>
